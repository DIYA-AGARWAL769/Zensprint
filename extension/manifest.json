{
  "manifest_version": 3,
  "name": "ZenSprint Focus Cop",
  "version": "1.5",
  "description": "Redirect selected distracting sites to your ZenSprint dashboard during focus sessions.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://zensprint-vy33.vercel.app/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.facebook.com/*",
    "*://*.twitter.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.linkedin.com/*",
    "*://*.netflix.com/*",
    "*://*.twitch.tv/*",
    "*://*.discord.com/*",
    "*://*.pinterest.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zensprint-vy33.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZenSprint Focus Cop",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
